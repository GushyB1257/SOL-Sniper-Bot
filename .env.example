# ---------------------------------------------------------------------------
# SOL Sniper Bot configuration
# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# === MODE ==================================================================
# paper  : forward test. Real launches, real filters, real live prices off each
#          token's bonding curve — but no transactions and no wallet needed.
#          START HERE. Results are a ceiling: paper assumes every buy landed
#          and every sell found a bid.
# live   : sign and broadcast real transactions with real money.
MODE=paper

# === RPC ===================================================================
# Needed in BOTH modes — paper mode reads real prices through it.
# The public endpoint is rate-limited into uselessness for sniping. Use a paid
# node (Helius / QuickNode / Triton); the free tiers are fine for paper mode.
# Sniping is a latency game; a slow RPC means you buy after the people you are
# trying to front-run.
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# === WALLET ================================================================
# Base58-encoded secret key (Phantom "export private key" format).
# Use a BURNER wallet funded with only what you can lose. Not your main wallet.
# Leave blank in paper mode.
WALLET_PRIVATE_KEY=

# === ENTRY MODE ============================================================
# screener : the filter a human sits and watches, applied automatically — venue,
#            volume, market cap, socials. Enters the instant a token matches.
#            No model in the entry path. This is the default.
# fast     : deterministic momentum trigger on the trade stream.
# ai       : Claude decides entries. It thinks for seconds, so fast moves are
#            gone before it answers. Use for slower, more considered entries.
# rules    : original creation-time sniper.
ENTRY_MODE=screener

# === SCREENER FILTER (ENTRY_MODE=screener) =================================
# Every threshold here is adjustable, and every one of them is a guess until
# you have run a few hundred paper trades. `npm run report` breaks results down
# by entry market cap, volume, age and socials — move the threshold whose worst
# bucket is both large and losing money. That is the tuning loop.
#
# Venues to accept. "pump" alone means pump.fun standard coins only.
SCREEN_ALLOWED_POOLS=pump
# Minimum market cap in USD. A fresh pump.fun launch sits around $5-6k, so a
# $6k floor means "has moved at all".
SCREEN_MIN_MCAP_USD=6000
# Total traded volume in USD, both sides, including the deployer's creation buy.
SCREEN_MIN_VOLUME_USD=3000
# Distinct social links (twitter / telegram / website) in the token metadata.
# Costs one HTTP fetch, so it is checked LAST — only for tokens that already
# cleared everything else. Set 0 to skip the check entirely.
SCREEN_MIN_SOCIALS=1
# What to do when the metadata cannot be READ — a slow or rate-limited IPFS
# gateway, which is common. That is not evidence the token has no socials, so
# the default lets it through. `deny` is the strict reading of the filter, at
# the cost of silently dropping real matches whenever a gateway is having a
# bad day.
SCREEN_ON_SOCIALS_UNAVAILABLE=allow
# Age band in seconds. Narrowing this is the strongest lever on the strategy:
# the pattern being traded is a pop in the first seconds after the filter
# matches, so 0-60 is worth testing against the default.
SCREEN_MIN_AGE_SECONDS=0
SCREEN_MAX_AGE_SECONDS=600

# --- Optional tighteners. Both OFF by default: they are NOT part of the
# --- filter above, and a bot that refuses to buy something that matched is
# --- indistinguishable from a broken one. Turn them on once `npm run report`
# --- shows those entries losing money.
#
# Ceiling on entry market cap, in USD. 0 = no ceiling.
SCREEN_MAX_MCAP_USD=0
# Minimum distinct buying wallets, so one wallet cannot manufacture the volume
# and market cap the other filters read. 0 = no minimum.
SCREEN_MIN_BUYERS=0

# Used to convert SOL to USD only when the live price feed is unreachable.
# If the feed is down and this is stale, every USD threshold above is wrong —
# the bot warns once a minute when that is happening.
SOL_USD_FALLBACK=190
# Buys are serialised so two matches cannot both clear the position cap. A
# match waiting longer than this behind other entries is dropped rather than
# filled late, since by then it is a different setup.
ENTRY_QUEUE_MAX_WAIT_SECONDS=20

# --- Momentum trigger (ENTRY_MODE=fast) ---
# Look at the last N seconds of trading.
MOMENTUM_WINDOW_SECONDS=30
# Ignore tokens outside this age band.
MOMENTUM_MIN_AGE_SECONDS=15
MOMENTUM_MAX_AGE_SECONDS=900
# Price must be up this much across the window.
MOMENTUM_MIN_GAIN_PCT=12
# A crowd, not one whale round-tripping.
MOMENTUM_MIN_BUYERS=6
MOMENTUM_MIN_VOLUME_SOL=1.5
MOMENTUM_MIN_BUY_SELL_RATIO=1.8
# Refuse to chase a token already up this much — the easy money is gone.
MOMENTUM_MAX_CHASE_PCT=250

# === FEES AND THE SCALP TARGET =============================================
# Fees per side. These drive the exit target, so they must match reality.
PROGRAM_FEE_PCT=1
ROUTER_FEE_PCT=0.5

# Quick in-and-out instead of the long ladder.
SCALP_MODE=true
# NET profit target as a percent of the SOL committed, AFTER all fees. The bot
# computes the gross move needed to deliver it — run `npm run doctor` to see it.
#
# IMPORTANT: at 0.05 SOL with a 0.0008 priority fee, round-trip fees are 6.3%.
# A "quick 5% scalp" at that size LOSES money no matter how well it is timed.
# Raise BUY_AMOUNT_SOL to 0.25+ to make small targets viable.
SCALP_TARGET_NET_PCT=8
SCALP_STOP_LOSS_PCT=18
# Screener entries pop and then roll over within about a minute, so a position
# that has not moved by now is occupying a slot rather than working.
SCALP_TIME_STOP_SECONDS=60
# Once a trade clears breakeven by this much, a give-back floor arms under it.
SCALP_BREAKEVEN_ARM_PCT=3
# Percent of the PEAK GAIN the trade may hand back before it is cut. This is
# the parameter that matters most for tokens that spike then crash: at 40%, a
# position that peaked at +30% exits near +18% instead of riding back to flat.
# Lower = bank sooner and more often; higher = let winners run further.
SCALP_GIVEBACK_PCT=40
# Percent kept running after the target fills, in case it keeps going.
SCALP_RUNNER_PCT=20
SCALP_RUNNER_TRAILING_STOP_PCT=35

# === STRATEGY ==============================================================
# ai    : run the watchlist. Required by ENTRY_MODE=screener/fast/ai — it is
#         what tracks launches and their trade flow. Only actually calls the
#         API when ENTRY_MODE=ai or AI_MANAGE_EXITS=true.
# rules : the original deterministic sniper (buys at creation on hard filters).
STRATEGY=ai

# Get a key at https://console.anthropic.com. Paper mode still calls the API,
# so this costs real money even though no SOL is spent.
ANTHROPIC_API_KEY=

AI_MODEL=claude-opus-5
# Reasoning depth. high is the sensible default; low/medium cost less per call.
AI_EFFORT=high
AI_TIMEOUT_MS=60000
# Analyst confidence (0-100) required before a position is opened.
AI_MIN_CONFIDENCE=65
# How often each open position is re-judged against its own thesis.
AI_REVIEW_INTERVAL_SECONDS=90

# --- Cost guards. Both are hard stops. ---
# Rolling cap on analyst calls per hour.
AI_MAX_CALLS_PER_HOUR=60
# Stop calling the API once estimated spend for the day passes this.
AI_DAILY_BUDGET_USD=10
# Let Claude review and exit open positions. OFF by default: screener positions
# are held for under a minute, so a review on a 90-second cadence never arrives
# before the mechanical exit does. With it off the bot makes no API calls at
# all and ANTHROPIC_API_KEY can stay blank. Turn it on for longer holds.
AI_MANAGE_EXITS=false

# === TRACTION GATE =========================================================
# Every launch goes on a watchlist; only those meeting ALL of these get sent
# to the analyst. This is the main cost lever — loosening it raises the bill
# faster than it raises the hit rate.
WATCHLIST_MAX_SIZE=1500
# Ignore tokens younger than this (no signal yet) or older (move already made).
WATCH_MIN_AGE_SECONDS=20
WATCH_MAX_AGE_SECONDS=1800
# A crowd, not a few wallets trading with each other.
MIN_UNIQUE_BUYERS=8
MIN_BUY_VOLUME_SOL=1.5
# Reject tokens already down this much since we started watching.
MIN_PRICE_CHANGE_PCT=-10
# Buyers must still be arriving in the last 60s — a stalled wave is not a setup.
MIN_RECENT_BUYERS=2

# === POSITION SIZING =======================================================
# SOL committed per position. This is the single most decisive number in a
# scalp strategy, because the priority fee is FIXED per transaction and so eats
# a larger share of a smaller position. At 0.05 SOL the round-trip breakeven
# move is 6.3%; at 0.25 SOL it is 3.7%. Sizing down does not reduce risk here
# so much as it raises the bar every trade has to clear to be worth taking.
# `npm run doctor` prints the arithmetic for whatever you set.
BUY_AMOUNT_SOL=0.25
# Never hold more than this many open positions at once.
MAX_CONCURRENT_POSITIONS=8
# Refuse to open new positions if wallet balance drops below this (gas buffer).
MIN_WALLET_RESERVE_SOL=0.1

# === EXECUTION =============================================================
# Slippage tolerance in percent on entry. New launches move fast; too tight
# and every buy fails, too loose and you eat a sandwich.
BUY_SLIPPAGE_PCT=15
SELL_SLIPPAGE_PCT=25
# Priority fee in SOL. This is what actually determines whether you land early.
PRIORITY_FEE_SOL=0.0008
# Jito tip in SOL (0 disables bundle submission).
JITO_TIP_SOL=0

# === EXIT LADDER ===========================================================
# Take-profit tiers: "gainPct:sellPctOfOriginal" pairs, comma separated.
# Default: at +60% sell 40%, at +150% sell 30%, at +400% sell 20%.
# That leaves 10% as the moonbag. Cost basis is fully recovered by tier 2.
EXIT_LADDER=60:40,150:30,400:20

# Hard stop loss (percent below entry) — exits the whole position.
STOP_LOSS_PCT=35
# Trailing stop (percent below peak), armed once the first tier fills.
TRAILING_STOP_PCT=45
# Moonbag trailing stop — looser, this is the lottery ticket.
MOONBAG_TRAILING_STOP_PCT=70
# Bail out if the position is still below TIME_STOP_MIN_GAIN_PCT after N seconds.
TIME_STOP_SECONDS=180
TIME_STOP_MIN_GAIN_PCT=10
# Absolute maximum hold time for the moonbag, in seconds (24h default).
MAX_HOLD_SECONDS=86400

# === SAFETY FILTERS ========================================================
# Reject if the deployer's own creation buy exceeds this % of total supply.
MAX_DEV_BUY_PCT=8
# Reject if the top 10 holders control more than this % (checked post-launch).
MAX_TOP10_HOLDER_PCT=65
# Require the deployer wallet to hold at least this much SOL (filters throwaway
# spam deployers that mint hundreds of tokens from dust wallets).
MIN_DEPLOYER_BALANCE_SOL=0.15
# Reject deployers whose previous tokens rugged more than this fraction of the
# time (needs local history — starts permissive and tightens as it learns).
MAX_DEPLOYER_RUG_RATE=0.34
# Minimum safety score (0-100) required to buy.
MIN_SAFETY_SCORE=70
# Require token metadata to resolve and contain at least one social link.
REQUIRE_SOCIALS=true
# Reject names/symbols that duplicate a token seen in the last N minutes
# (copycat spam around a trending ticker).
DUPLICATE_NAME_WINDOW_MINUTES=60

# === RISK CIRCUIT BREAKERS =================================================
# Stop trading for the rest of the UTC day after losing this much SOL.
DAILY_LOSS_LIMIT_SOL=1.5
# Stop trading after this many consecutive losing trades.
MAX_CONSECUTIVE_LOSSES=6
# Cooldown (seconds) after the consecutive-loss breaker trips.
BREAKER_COOLDOWN_SECONDS=900
# Max SOL deployed into new positions per rolling hour. At 0.25 SOL a position
# this allows 20 entries an hour, which is the cap on "volume trading".
HOURLY_SPEND_CAP_SOL=5

# === DISCOVERY =============================================================
# pumpportal  : websocket feed of new pump.fun launches (free, no key)
# rpc         : direct logsSubscribe on the pump.fun program via your own RPC
DISCOVERY_SOURCE=pumpportal
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# Ignore launches older than this many ms by the time we see them. Sniping a
# 30-second-old token is not sniping, it is buying someone else's exit.
MAX_CANDIDATE_AGE_MS=5000

# === EXECUTION BACKEND =====================================================
# paper    : no transactions at all (forced whenever MODE=paper)
# onchain  : build the swap via PumpPortal's local API, sign it with your own
#            key and broadcast through your own RPC. Non-custodial — the key
#            never leaves this machine.
# axiom    : not implemented; see src/execution/axiom.ts for why.
EXECUTOR=paper
PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade-local

# === DASHBOARD =============================================================
# Local web UI: live P&L, open positions, risk limits, config, activity log.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=4321
# Loopback only. Do NOT change this to 0.0.0.0 — the dashboard can force-sell
# positions, and binding it to a public interface hands that to anyone who can
# reach the port. If you need it remotely, tunnel it over SSH instead.
DASHBOARD_HOST=127.0.0.1

# === MISC ==================================================================
LOG_LEVEL=info
DATA_DIR=./data
