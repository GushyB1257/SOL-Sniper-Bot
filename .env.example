# ---------------------------------------------------------------------------
# GushyB's SOL Moneymaker — configuration
# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# === MODE ==================================================================
# paper  : forward test. Real launches, real filters, real live prices off each
#          token's bonding curve — but no transactions and no wallet needed.
#          START HERE. Results are a ceiling: paper assumes every buy landed
#          and every sell found a bid.
# live   : sign and broadcast real transactions with real money.
MODE=paper

# === RPC ===================================================================
# Needed in BOTH modes — paper mode reads real prices through it.
# The public endpoint is rate-limited into uselessness for sniping. Use a paid
# node (Helius / QuickNode / Triton); the free tiers are fine for paper mode.
# Sniping is a latency game; a slow RPC means you buy after the people you are
# trying to front-run.
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# --- RPC rate limiting (the fix for 429 errors) ---
# Every RPC call the bot makes goes through one throttle, and a 429 is retried
# with backoff rather than surfaced — an unhandled 429 on the exit path is a
# sell that did not happen, which is a position you are stuck holding.
#
# Set this to your provider's documented limit: 10 for a typical free tier,
# much higher on a paid plan. 0 disables the cap.
RPC_MAX_REQUESTS_PER_SEC=20
# Requests in flight at once. A burst can breach a per-second limit even when
# the average is comfortably inside it.
RPC_MAX_CONCURRENT=8
# Retries for a 429 or a 5xx, with exponential backoff and jitter.
RPC_MAX_RETRIES=4
# How many launches the SNIPER runs the safety battery on at once. This is the
# usual source of a 429: the battery is four RPC calls per launch and pump.fun
# deploys several tokens a second at peak. Beyond this limit candidates are
# dropped rather than queued — one that had to wait its turn is one you are too
# late to buy anyway.
SNIPER_MAX_CONCURRENT_CHECKS=4

# === WALLET ================================================================
# Base58-encoded secret key (Phantom "export private key" format).
# Use a BURNER wallet funded with only what you can lose. Not your main wallet.
# Leave blank in paper mode.
WALLET_PRIVATE_KEY=

# === WHICH BOTS RUN ========================================================
# Three independent strategies. Each has its own positions, P&L and risk
# limits, so one bot's bad day cannot spend another's budget or muddy its
# numbers. All three appear as tabs on the dashboard, and everything below can
# be changed there while the bot is running — no restart, no editing this file.
#
# screener : the filter strategy (volume / market cap / socials). Below.
# sniper   : the original creation-time sniper on the safety battery.
# copy     : mirrors wallets you nominate.
BOT_SCREENER_ENABLED=true
BOT_SNIPER_ENABLED=false
BOT_COPY_ENABLED=false

# --- Provenance checks (sniper). All OFF by default. ----------------------
# These read where a launch came from rather than what it looks like. Each
# except the first costs an RPC call on the entry path, and the sniper is
# already the heaviest RPC consumer — watch the throttle chip if you turn
# several on at once.
#
# Distinct holders required. FREE: reuses the read the concentration check
# already makes. Capped at 20 by what the RPC returns.
MIN_HOLDERS=0
# Reject when the deployer has already sold out of their own token. MAX_DEV_BUY
# _PCT asks what they took at creation; this asks whether they are still in it,
# which is invisible to any check reading only the creation transaction.
REJECT_IF_DEPLOYER_EXITED=false
# Minimum age of the deployer's wallet, in minutes. Catches a FUNDED throwaway,
# which a balance check alone does not.
MIN_CREATOR_AGE_MINUTES=0
# Reject when more than this many transactions landed in the creation slot.
# Organic interest arrives across slots; a bundle lands together, which is the
# signature of a launch whose first buyers are the deployer's own wallets.
MAX_LAUNCH_BUNDLE_TXS=0

# === COPY TRADING (BOT_COPY_ENABLED) =======================================
# Wallets to mirror, comma or newline separated. Can be left empty and filled in
# from the dashboard later — the bot starts, it just has nothing to follow yet.
# Append =Name to give a wallet a nickname; that name is what the dashboard
# shows on every position and closed trade copied from it, e.g.
#   COPY_WALLETS=9xQe...4Rt=Insider, 4Kp8...zzQ=Whale
# Names are resolved when the page renders, so renaming a wallet relabels its
# whole trade history rather than only the trades that come after.
COPY_WALLETS=
# Ignore buys smaller than this, in SOL. THE MOST IMPORTANT SETTING HERE:
# wallets routinely make dust buys purely to push a token up a screener's
# volume ranking, and following those leaves you holding something they never
# actually took a position in. Priced through the bonding curve, so it is a
# real SOL amount rather than a token count.
COPY_MIN_BUY_SOL=0.5
# Ignore buys larger than this. A whale's size is not your size. 0 disables.
COPY_MAX_BUY_SOL=0
# fixed        : always buy COPY_BUY_AMOUNT_SOL.
# proportional : buy COPY_RATIO x whatever they spent.
COPY_SIZE_MODE=fixed
COPY_BUY_AMOUNT_SOL=0.25
COPY_RATIO=0.1
# Hard ceiling on one copied position, whatever the sizing says.
COPY_MAX_POSITION_SOL=0.5
COPY_ALLOWED_POOLS=pump,pump-amm
# Only follow tokens they buy AFTER tracking starts, rather than piling into
# every bag they are already holding.
COPY_SKIP_PREEXISTING=true
# Sells mirror the FRACTION they sold, not the amount: they dump 40% of their
# bag, you sell 40% of yours. 1 mirrors exactly; above 1 exits faster than they
# do, which front-runs a wallet that unwinds in stages.
COPY_SELL_MULTIPLIER=1
# Close fully once they have sold at least this much in one go.
COPY_FULL_EXIT_AT_PCT=90
# Backstop if they simply never sell.
COPY_MAX_HOLD_SECONDS=86400
# How often tracked wallets' token balances are re-read. Balances are read
# rather than trades subscribed to, because a balance is the truth right now —
# a missed message costs a trade, a missed poll costs one interval.
#
# This is the single biggest term in how late you are to a wallet's trade.
# Wallets are polled concurrently and both token programs are read in parallel,
# so lowering it costs RPC calls rather than cycle time. Below ~800ms a
# consumer endpoint starts rate-limiting, which makes you slower, not faster.
COPY_POLL_INTERVAL_MS=1000

# --- Flow filters. All OFF (0) by default. --------------------------------
# These read signals the bot already collects but never filtered on. A volume
# threshold cannot tell a token that is still moving from one that stopped,
# fifty buyers from one whale, or the start of a move from its second half.
#
# Reject if nothing has traded for this long. Volume with no flow behind it
# looks identical to a live token on a volume filter.
SCREEN_MAX_SECONDS_SINCE_TRADE=0
# Refuse to buy more than this far below the high seen since we started
# watching — buying a token 60% off its peak is the second half of a move.
SCREEN_MAX_DRAWDOWN_PCT=0
# Buyers in the last 60s divided by the 60s before. Above 1 means the wave is
# still building; below 1 means it already broke.
SCREEN_MIN_BUYER_ACCEL=0
# Buy volume minus sell volume, in SOL. A 2:1 ratio is the same number whether
# it is on 0.2 SOL or 20, and the difference between those is the whole trade.
SCREEN_MIN_NET_FLOW_SOL=0
# Average and largest single buy. A floor filters out dust participation; a
# ceiling on the average catches one whale posing as a crowd.
SCREEN_MIN_AVG_BUY_SOL=0
SCREEN_MAX_AVG_BUY_SOL=0
SCREEN_MIN_LARGEST_BUY_SOL=0
# Wallets that bought twice. Conviction rather than a glance.
SCREEN_MIN_REPEAT_BUYERS=0
# Where on the bonding curve you are willing to buy, 0-100% toward graduation.
SCREEN_MIN_CURVE_PROGRESS_PCT=0
SCREEN_MAX_CURVE_PROGRESS_PCT=0
# Require this many of your copy-tracked wallets to be holding it.
#
# The copy bot polls those balances every second anyway, so this costs nothing
# — and it is the one signal here that is NOT available to anyone screening the
# same public data. Needs the copy bot running with wallets configured.
SCREEN_MIN_COPY_HOLDERS=0

# === ENTRY MODE ============================================================
# screener : the filter a human sits and watches, applied automatically — venue,
#            volume, market cap, socials. Enters the instant a token matches.
#            No model in the entry path. This is the default.
# fast     : deterministic momentum trigger on the trade stream.
# ai       : Claude decides entries. It thinks for seconds, so fast moves are
#            gone before it answers. Use for slower, more considered entries.
# rules    : original creation-time sniper.
ENTRY_MODE=screener

# === SCREENER FILTER (ENTRY_MODE=screener) =================================
# Every threshold here is adjustable, and every one of them is a guess until
# you have run a few hundred paper trades. `npm run report` breaks results down
# by entry market cap, volume, age and socials — move the threshold whose worst
# bucket is both large and losing money. That is the tuning loop.
#
# Venues to accept. "pump" alone means pump.fun standard coins only.
SCREEN_ALLOWED_POOLS=pump
# Minimum market cap in USD. A fresh pump.fun launch sits around $5-6k, so a
# $6k floor means "has moved at all".
SCREEN_MIN_MCAP_USD=6000
# Total traded volume in USD, both sides, including the deployer's creation buy.
SCREEN_MIN_VOLUME_USD=3000
# Distinct social links (twitter / telegram / website) in the token metadata.
# Costs one HTTP fetch, so it is checked LAST — only for tokens that already
# cleared everything else. Set 0 to skip the check entirely.
SCREEN_MIN_SOCIALS=1
# What to do when the metadata cannot be READ — a slow or rate-limited IPFS
# gateway, which is common. That is not evidence the token has no socials, so
# the default lets it through. `deny` is the strict reading of the filter, at
# the cost of silently dropping real matches whenever a gateway is having a
# bad day.
SCREEN_ON_SOCIALS_UNAVAILABLE=allow
# Age band in seconds. Narrowing this is the strongest lever on the strategy:
# the pattern being traded is a pop in the first seconds after the filter
# matches, so 0-60 is worth testing against the default.
SCREEN_MIN_AGE_SECONDS=0
SCREEN_MAX_AGE_SECONDS=600

# --- Optional tighteners. Both OFF by default: they are NOT part of the
# --- filter above, and a bot that refuses to buy something that matched is
# --- indistinguishable from a broken one. Turn them on once `npm run report`
# --- shows those entries losing money.
#
# Ceiling on entry market cap, in USD. 0 = no ceiling.
SCREEN_MAX_MCAP_USD=0
# Minimum distinct buying wallets, so one wallet cannot manufacture the volume
# and market cap the other filters read. 0 = no minimum.
SCREEN_MIN_BUYERS=0

# --- Where market cap and volume come from ---
# curve : read each watched token's bonding curve over YOUR RPC. Exact market
#         cap, and volume that is right on the first read of a token — the
#         trade feed can only tell you about trades after you subscribed.
# feed  : PumpPortal's per-token trade stream only. Lower RPC load, but the
#         strategy then depends on a free shared websocket honouring a
#         subscription for every launch. If it stops, nothing is screened.
# both  : default. Whichever source saw more volume wins.
SCREEN_DATA_SOURCE=both
# How often watched curves are re-read, and how many at a time (youngest
# first). Each RPC call covers 100 tokens, so 300 every 1500ms is about 2
# requests a second — fine on a free Helius tier. `npm run doctor` prints the
# exact rate for your settings.
SCREEN_POLL_INTERVAL_MS=1500
SCREEN_POLL_MAX_TOKENS=300

# Used to convert SOL to USD only when the live price feed is unreachable.
# If the feed is down and this is stale, every USD threshold above is wrong —
# the bot warns once a minute when that is happening.
SOL_USD_FALLBACK=190
# Buys are serialised so two matches cannot both clear the position cap. A
# match waiting longer than this behind other entries is dropped rather than
# filled late, since by then it is a different setup.
ENTRY_QUEUE_MAX_WAIT_SECONDS=20

# --- Momentum trigger (ENTRY_MODE=fast) ---
# Look at the last N seconds of trading.
MOMENTUM_WINDOW_SECONDS=30
# Ignore tokens outside this age band.
MOMENTUM_MIN_AGE_SECONDS=15
MOMENTUM_MAX_AGE_SECONDS=900
# Price must be up this much across the window.
MOMENTUM_MIN_GAIN_PCT=12
# A crowd, not one whale round-tripping.
MOMENTUM_MIN_BUYERS=6
MOMENTUM_MIN_VOLUME_SOL=1.5
MOMENTUM_MIN_BUY_SELL_RATIO=1.8
# Refuse to chase a token already up this much — the easy money is gone.
MOMENTUM_MAX_CHASE_PCT=250

# === FEES AND THE SCALP TARGET =============================================
# Fees per side. These drive the exit target, so they must match reality.
PROGRAM_FEE_PCT=1
ROUTER_FEE_PCT=0.5

# === AUTO-TUNING ===========================================================
# Let Claude adjust the bots' strategy settings from their own closed trades,
# continuously, so they improve the more you run them.
#
# OFF by default, deliberately: it spends API credit on a schedule and it edits
# the settings you are trading on. Turn it on here or on the Auto-tune tab.
#
# WHAT IT CAN TOUCH is fixed in code (src/tuner/limits.ts), not in config, so
# it cannot be widened from here. It covers 97 parameters: every entry filter,
# the whole safety battery, all three exit machineries, copy-trade behaviour,
# execution settings, RPC limits, the analyst's budget — AND THE RISK LIMITS.
#
# Read that last part twice. The tuner can change how much money is at stake
# per trade (BUY_AMOUNT_SOL) and how much you can lose in a day
# (DAILY_LOSS_LIMIT_SOL), along with concurrent positions, the hourly spend
# cap, the loss-streak breaker, the wallet reserve, slippage and the stop loss.
# In paper mode that costs nothing. In live mode the bounds in limits.ts are
# the only thing between a bad inference and a bad afternoon — position size is
# capped at 2 SOL and may move at most 25% per round. Risk changes are flagged
# in the log and tagged RISK on the dashboard so they are never quiet.
#
# STILL EXCLUDED: the tuner's own settings (they ARE the enforcement), the fee
# constants and SOL price fallback (facts about the world, not choices —
# changing them only makes the breakeven wrong), BOT_*_ENABLED (controls, not
# parameters), and COPY_WALLETS (your input, not a knob).
#
# HOW IT AVOIDS FOOLING ITSELF: one change at a time per bot, held still, then
# expectancy over the trades that follow is compared against the window before
# it. A change that does not beat its baseline is reverted automatically, and
# will not be proposed again. Every change, its stated reason and its verdict
# are on the Auto-tune tab and in data/tuning.json.
AUTO_TUNE_ENABLED=false
# Minimum minutes between reviews OF THE SAME BOT. A floor, not a schedule:
# what actually triggers a review is the trade count below, because 40 trades
# is 40 trades whether they took two minutes or two days. This bounds API
# spend and stops a burst of fast trades producing a run of changes before any
# of them has had a chance to show an effect. Per bot, so a fast bot never
# waits on a slow one.
TUNER_INTERVAL_MINUTES=20
# Closed trades required before anything moves, and again before a change is
# judged. Under a few dozen, memecoin P&L is one or two outliers and any change
# can be justified from the noise.
#
# THIS is the knob to raise if your bots trade quickly. Trades are the currency
# of statistical confidence and they cost nothing but time — 150 per decision
# is a far better read than 40, and if you close 40 in two minutes it barely
# slows anything down.
TUNER_MIN_TRADES=40
# Parameters that may move in one round. Keep this low: changing several things
# at once means the measurement cannot attribute the result to any of them.
TUNER_MAX_CHANGES_PER_ROUND=2
# Largest single-round move for any parameter, as a share of its current value.
# This is what stops a series of individually reasonable rounds walking a
# setting somewhere no single round would have proposed.
TUNER_MAX_STEP_PCT=30

# === EXIT ==================================================================
# ratchet : NO STOP LOSS. Every CHECKPOINT_SECONDS the price has to be higher
#           than it was at the last check, or the position is sold. On a double
#           it sells exactly enough to return your stake, and everything still
#           held after that is pure profit.
# scalp   : fee-aware net target, give-back floor, hard stop loss.
# ladder  : the original +60/+150/+400% rungs with trailing stops.
EXIT_MODE=ratchet

# --- Ratchet (EXIT_MODE=ratchet) ---
# How often the "is it higher than last time?" question gets asked.
CHECKPOINT_SECONDS=60
# Length of the FIRST window only. Every position that goes nowhere pays for
# the whole first window before anything can cut it, and on a launch that has
# already turned over most of the damage lands in the first thirty seconds.
# Shortening only the first window cuts the dead entries sooner without
# shortening the leash on one that is working. Set it to 60 for one length
# throughout.
RATCHET_FIRST_CHECKPOINT_SECONDS=30
# Gain at which the stake comes back off the table. 100 = a double, which is a
# high bar: everything that stalls at +40% or +70% on the way there is still
# carrying full downside when it turns. Lower converts more trades into
# risk-free ones at the cost of a smaller moonbag.
RECOVER_AT_GAIN_PCT=60
# Close the position if it hands back this share of its best GAIN.
#
# This is NOT a stop loss and cannot act like one: it is measured against the
# gain above entry, so a position that is down has no gain to give back and
# this can never fire on it. It plugs the ratchet's biggest leak — between
# checkpoints a position could run to +90%, give all of it back, and still be
# holding when the window finally closed. 0 disables it.
RATCHET_GIVEBACK_PCT=40
# Share of the remaining moonbag skimmed at each checkpoint it survives.
MOONBAG_TRIM_PCT=25
# How much higher than the last checkpoint counts as "still going". 0 means any
# new high survives; raise it to cut tokens that are only drifting.
RATCHET_MIN_PROGRESS_PCT=0
# Optional hard stop, OFF by default. A stop is exactly what cuts a position
# that then recovers, which is why this mode does not have one. Set a
# percentage to put one back.
#
# READ THIS: with no stop, the most a single trade can lose is the FULL
# BUY_AMOUNT_SOL. A rug completes in seconds, well inside one checkpoint, and
# nothing here sells on price. DAILY_LOSS_LIMIT_SOL is what bounds a bad day.
RATCHET_STOP_LOSS_PCT=0

# NET profit target as a percent of the SOL committed, AFTER all fees. The bot
# computes the gross move needed to deliver it — run `npm run doctor` to see it.
#
# IMPORTANT: at 0.05 SOL with a 0.0008 priority fee, round-trip fees are 6.3%.
# A "quick 5% scalp" at that size LOSES money no matter how well it is timed.
# Raise BUY_AMOUNT_SOL to 0.25+ to make small targets viable.
SCALP_TARGET_NET_PCT=8
SCALP_STOP_LOSS_PCT=18
# Screener entries pop and then roll over within about a minute, so a position
# that has not moved by now is occupying a slot rather than working.
SCALP_TIME_STOP_SECONDS=60
# Once a trade clears breakeven by this much, a give-back floor arms under it.
SCALP_BREAKEVEN_ARM_PCT=3
# Percent of the PEAK GAIN the trade may hand back before it is cut. This is
# the parameter that matters most for tokens that spike then crash: at 40%, a
# position that peaked at +30% exits near +18% instead of riding back to flat.
# Lower = bank sooner and more often; higher = let winners run further.
SCALP_GIVEBACK_PCT=40
# Percent kept running after the target fills, in case it keeps going.
SCALP_RUNNER_PCT=20
SCALP_RUNNER_TRAILING_STOP_PCT=35

# === STRATEGY ==============================================================
# ai    : run the watchlist. Required by ENTRY_MODE=screener/fast/ai — it is
#         what tracks launches and their trade flow. Only actually calls the
#         API when ENTRY_MODE=ai or AI_MANAGE_EXITS=true.
# rules : the original deterministic sniper (buys at creation on hard filters).
STRATEGY=ai

# Get a key at https://console.anthropic.com. Paper mode still calls the API,
# so this costs real money even though no SOL is spent.
ANTHROPIC_API_KEY=

AI_MODEL=claude-opus-5
# Reasoning depth. high is the sensible default; low/medium cost less per call.
AI_EFFORT=high
AI_TIMEOUT_MS=60000
# Analyst confidence (0-100) required before a position is opened.
AI_MIN_CONFIDENCE=65
# How often each open position is re-judged against its own thesis.
AI_REVIEW_INTERVAL_SECONDS=90

# --- Cost guards. Both are hard stops. ---
# Rolling cap on analyst calls per hour.
AI_MAX_CALLS_PER_HOUR=60
# Stop calling the API once estimated spend for the day passes this.
AI_DAILY_BUDGET_USD=10
# Let Claude review and exit open positions. OFF by default: screener positions
# are held for under a minute, so a review on a 90-second cadence never arrives
# before the mechanical exit does. With it off the bot makes no API calls at
# all and ANTHROPIC_API_KEY can stay blank. Turn it on for longer holds.
AI_MANAGE_EXITS=false

# === TRACTION GATE =========================================================
# Every launch goes on a watchlist; only those meeting ALL of these get sent
# to the analyst. This is the main cost lever — loosening it raises the bill
# faster than it raises the hit rate.
WATCHLIST_MAX_SIZE=1500
# Ignore tokens younger than this (no signal yet) or older (move already made).
WATCH_MIN_AGE_SECONDS=20
WATCH_MAX_AGE_SECONDS=1800
# A crowd, not a few wallets trading with each other.
MIN_UNIQUE_BUYERS=8
MIN_BUY_VOLUME_SOL=1.5
# Reject tokens already down this much since we started watching.
MIN_PRICE_CHANGE_PCT=-10
# Buyers must still be arriving in the last 60s — a stalled wave is not a setup.
MIN_RECENT_BUYERS=2

# === POSITION SIZING =======================================================
# SOL committed per position. This is the single most decisive number in a
# scalp strategy, because the priority fee is FIXED per transaction and so eats
# a larger share of a smaller position. At 0.05 SOL the round-trip breakeven
# move is 6.3%; at 0.25 SOL it is 3.7%. Sizing down does not reduce risk here
# so much as it raises the bar every trade has to clear to be worth taking.
# `npm run doctor` prints the arithmetic for whatever you set.
BUY_AMOUNT_SOL=0.25
# Never hold more than this many open positions at once.
MAX_CONCURRENT_POSITIONS=8
# Refuse to open new positions if wallet balance drops below this (gas buffer).
MIN_WALLET_RESERVE_SOL=0.1

# === EXECUTION =============================================================
# Slippage tolerance in percent on entry. New launches move fast; too tight
# and every buy fails, too loose and you eat a sandwich.
BUY_SLIPPAGE_PCT=15
SELL_SLIPPAGE_PCT=25
# Priority fee in SOL. This is what actually determines whether you land early.
PRIORITY_FEE_SOL=0.0008
# Jito tip in SOL (0 disables bundle submission).
JITO_TIP_SOL=0

# === EXIT LADDER ===========================================================
# Take-profit tiers: "gainPct:sellPctOfOriginal" pairs, comma separated.
# Default: at +60% sell 40%, at +150% sell 30%, at +400% sell 20%.
# That leaves 10% as the moonbag. Cost basis is fully recovered by tier 2.
EXIT_LADDER=60:40,150:30,400:20

# Hard stop loss (percent below entry) — exits the whole position.
STOP_LOSS_PCT=35
# Trailing stop (percent below peak), armed once the first tier fills.
TRAILING_STOP_PCT=45
# Moonbag trailing stop — looser, this is the lottery ticket.
MOONBAG_TRAILING_STOP_PCT=70
# Bail out if the position is still below TIME_STOP_MIN_GAIN_PCT after N seconds.
TIME_STOP_SECONDS=180
TIME_STOP_MIN_GAIN_PCT=10
# Absolute maximum hold time for the moonbag, in seconds (24h default).
MAX_HOLD_SECONDS=86400

# === SAFETY FILTERS ========================================================
# Reject if the deployer's own creation buy exceeds this % of total supply.
MAX_DEV_BUY_PCT=8
# Reject if the top 10 holders control more than this % (checked post-launch).
MAX_TOP10_HOLDER_PCT=65
# Require the deployer wallet to hold at least this much SOL (filters throwaway
# spam deployers that mint hundreds of tokens from dust wallets).
MIN_DEPLOYER_BALANCE_SOL=0.15
# Reject deployers whose previous tokens rugged more than this fraction of the
# time (needs local history — starts permissive and tightens as it learns).
MAX_DEPLOYER_RUG_RATE=0.34
# Minimum safety score (0-100) required to buy.
MIN_SAFETY_SCORE=70
# Require token metadata to resolve and contain at least one social link.
REQUIRE_SOCIALS=true
# Reject names/symbols that duplicate a token seen in the last N minutes
# (copycat spam around a trending ticker).
DUPLICATE_NAME_WINDOW_MINUTES=60

# === RISK CIRCUIT BREAKERS =================================================
# Stop trading for the rest of the UTC day after losing this much SOL.
DAILY_LOSS_LIMIT_SOL=1.5
# Stop trading after this many consecutive losing trades.
MAX_CONSECUTIVE_LOSSES=6
# Cooldown (seconds) after the consecutive-loss breaker trips.
BREAKER_COOLDOWN_SECONDS=900
# Max SOL deployed into new positions per rolling hour. At 0.25 SOL a position
# this allows 20 entries an hour, which is the cap on "volume trading".
HOURLY_SPEND_CAP_SOL=5

# === DISCOVERY =============================================================
# pumpportal  : websocket feed of new pump.fun launches (free, no key)
# rpc         : direct logsSubscribe on the pump.fun program via your own RPC
DISCOVERY_SOURCE=pumpportal
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# Ignore launches older than this many ms by the time we see them. Sniping a
# 30-second-old token is not sniping, it is buying someone else's exit.
MAX_CANDIDATE_AGE_MS=5000

# === EXECUTION BACKEND =====================================================
# paper    : no transactions at all (forced whenever MODE=paper)
# onchain  : build the swap via PumpPortal's local API, sign it with your own
#            key and broadcast through your own RPC. Non-custodial — the key
#            never leaves this machine.
# axiom    : not implemented; see src/execution/axiom.ts for why.
EXECUTOR=paper
PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade-local

# === DASHBOARD =============================================================
# Local web UI: live P&L, open positions, risk limits, config, activity log.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=4321
# Loopback only. Do NOT change this to 0.0.0.0 — the dashboard can force-sell
# positions, and binding it to a public interface hands that to anyone who can
# reach the port. If you need it remotely, tunnel it over SSH instead.
DASHBOARD_HOST=127.0.0.1

# === MISC ==================================================================
LOG_LEVEL=info
DATA_DIR=./data
